{
  "name": "@onno/ui",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@hello-pangea/dnd": "^18.0.1",
    "@internationalized/date": "^3.12.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.107.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^6.8.0",
    "postcss": "^8.5.23",
    "react-aria-components": "^1.17.0",
    "react-colorful": "^5.8.0",
    "react-router": "^8.3.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "description": "The onno UI: the React shell, default screens and everything an app builds its own UI from.",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons": {
      "types": "./src/icons.ts",
      "default": "./src/icons.ts"
    },
    "./vite": {
      "types": "./vite-preset.d.ts",
      "default": "./vite-preset.js"
    },
    "./eslint": {
      "types": "./eslint-plugin/index.d.ts",
      "default": "./eslint-plugin/index.js"
    }
  },
  "files": [
    "src",
    "public",
    "vite-preset.js",
    "vite-preset.d.ts",
    "tailwind.config.js",
    "eslint-plugin/index.js",
    "eslint-plugin/index.d.ts",
    "!src/**/*.test.*"
  ],
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  }
}
