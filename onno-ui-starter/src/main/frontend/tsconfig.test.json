{
  // Type-checks the Vitest suite and vite.config.ts, which tsconfig.app.json (src only) never sees.
  // Tests also import widget sources from onno-crm-starter, onno-crm-channels-starter and
  // onno-widget-sdk, so those are checked here too.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    // Tests run on Node 22, so they may use ES2022 APIs such as Array.prototype.at.
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    // vitest/jsdom declares the `jsdom` global (the JSDOM instance) the jsdom environment exposes.
    "types": [
      "vitest/globals",
      "vitest/jsdom",
      "node"
    ],
    // Widget sources outside this directory have no node_modules of their own. Resolve them as
    // Vitest does: React from this project's node_modules (@vitejs/plugin-react dedupes it, so
    // Vite resolves it from the project root), lucide-react and @onno/widget-sdk to the packages
    // the test aliases in vite.config.ts point at.
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ],
      "@onno/widget-sdk": [
        "../../../../onno-widget-sdk/src/index.ts"
      ]
    }
  },
  "include": [
    "tests",
    "vite.config.ts",
    "src/**/*.d.ts"
  ]
}
